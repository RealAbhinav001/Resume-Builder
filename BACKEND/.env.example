# Copy to BACKEND/.env and fill in. Never commit BACKEND/.env.
# OpenAI API key, used for AI bullet points.
OPEN_API_KEY=SECRET_KEY
# Port the server listens on. Hosting platforms like Render set this for you.
PORT=4000
# Frontend address(es) allowed to call the API (CORS), comma separated, no trailing slash.
CLIENT_URL=http://localhost:5173
# Optional: use an installed Chrome/Edge instead of Puppeteer's own download
# (or run `npx puppeteer browsers install chrome` once).
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
